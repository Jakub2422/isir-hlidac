 export type IsirFilters={query:string;person:string;ico:string;role:string;city:string;kind:string};
+export function readIsirOffset(p:URLSearchParams){
+ const raw=p.get('offset');
+ if(raw===null)return 0;
+ if(!/^\d+$/.test(raw)||!Number.isSafeInteger(Number(raw)))throw Error('Neplatný začátek stránky.');
+ return Number(raw);
+}
 export function readIsirFilters(p:URLSearchParams):IsirFilters{
  const text=(k:string,n=100)=>(p.get(k)||'').trim().slice(0,n),ico=text('ico',20).replace(/\s/g,'');
